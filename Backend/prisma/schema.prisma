generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int     @id @default(autoincrement())
  email       String? @unique
  phoneNumber String? @unique
  name        String
  authId      String? @unique

  userCreatedItineraries Itinerary[]
  onGuestLists           Guest[]
}

model Itinerary {
  id        String   @id @default(uuid())
  title     String
  date      DateTime
  location  String
  partySize Int      @default(1)

  creatorId Int?

  createdBy User? @relation(fields: [creatorId], references: [id], onDelete: SetNull)

  guestList Guest[]
  budget    Budget?
}

enum GuestStatus {
  INVITED
  CONFIRMED
  DECLINED
}

model Guest {
  id          Int         @id @default(autoincrement())
  userId      Int
  itineraryId String
  status      GuestStatus @default(INVITED)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  itinerary Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  @@unique([userId, itineraryId])
}

model Budget {
  id                Int     @id @default(autoincrement())
  themeDecorCost    Decimal @default(0) @db.Decimal(10, 2)
  venueCost         Decimal @default(0) @db.Decimal(10, 2)
  cateringCost      Decimal @default(0) @db.Decimal(10, 2)
  entertainmentCost Decimal @default(0) @db.Decimal(10, 2)
  additionalCost    Decimal @default(0) @db.Decimal(10, 2)

  itinerary   Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  itineraryId String    @unique
}
