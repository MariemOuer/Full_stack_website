{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "axios": "^1.7.9",
    "cra-template-pwa": "2.0.0",
    "firebase": "^11.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.5",
    "react-scripts": "5.0.1",
    "vercel": "^41.4.1"
  },
  "scripts": {
    "build": "react-scripts build",
    "start": "react-scripts start",
    "backend": "cd ../Backend && npm run dev",
    "frontend": "cd ../Frontend && npm start",
    "dev": "concurrently \"npm run backend\" \"cross-env NODE_ENV=development npm run frontend\""
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17"
  }
}
