{
  "compilerOptions": {
    "baseUrl": "src",
    "paths": {
      "@src/*": ["*"]
    },
    "moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": "./",
    "esModuleInterop": true,
    "skipLibCheck": true,

    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,

    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "allowUnusedLabels": false,
    "jsx": "react-jsx",
    "allowJs": true
  }
}
